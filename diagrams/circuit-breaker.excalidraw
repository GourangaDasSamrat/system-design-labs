    {
      "id": "cascadeBody",
      "type": "text",
      "x": 30,
      "y": 312,
      "width": 320,
      "height": 110,
      "text": "Service A → Service B → Service C 💥 DOWN\n\nAll threads in A hang waiting for B timeout\nAll threads in B hang waiting for C timeout\nThread pools exhaust → A goes down too\n→ Full cascade failure 🔥\n\nWith CB: A detects C is down, fails fast,\nreturns cached/default. A stays healthy.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "strokeColor": "#c92a2a",
      "verticalAlign": "middle",
      "groupIds": [],
      "roundness": null,
      "opacity": 100,
      "version": 2,
      "versionNonce": 936443401,
      "index": "aI",
      "isDeleted": false,
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "angle": 0,
      "backgroundColor": "transparent",
      "seed": 1,
      "frameId": null,
      "boundElements": [],
      "updated": 1774766407792,
      "link": null,
      "locked": false,
      "containerId": null,
      "originalText": "Service A → Service B → Service C 💥 DOWN\n\nAll threads in A hang waiting for B timeout\nAll threads in B hang waiting for C timeout\nThread pools exhaust → A goes down too\n→ Full cascade failure 🔥\n\nWith CB: A detects C is down, fails fast,\nreturns cached/default. A stays healthy.",
      "autoResize": true,
      "lineHeight": 1.0185185185185184
    },
