    {
      "id": "fallbackBody",
      "type": "text",
      "x": 390,
      "y": 312,
      "width": 320,
      "height": 110,
      "text": "Cached response  → last known good data\nDefault value    → empty array, 0 count\nStatic response  → maintenance message\nQueue request    → process later async\nRedirect         → static maintenance page\n\nLibraries: Resilience4j (Java), opossum (Node),\npolly (.NET), gobreaker (Go), Istio (mesh)",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "strokeColor": "#1971c2",
      "verticalAlign": "middle",
      "groupIds": [],
      "roundness": null,
      "opacity": 100,
      "version": 2,
      "versionNonce": 1576307239,
      "index": "aL",
      "isDeleted": false,
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "angle": 0,
      "backgroundColor": "transparent",
      "seed": 1,
      "frameId": null,
      "boundElements": [],
      "updated": 1774766407792,
      "link": null,
      "locked": false,
      "containerId": null,
      "originalText": "Cached response  → last known good data\nDefault value    → empty array, 0 count\nStatic response  → maintenance message\nQueue request    → process later async\nRedirect         → static maintenance page\n\nLibraries: Resilience4j (Java), opossum (Node),\npolly (.NET), gobreaker (Go), Istio (mesh)",
      "autoResize": true,
      "lineHeight": 1.1458333333333333
    }
  ],
